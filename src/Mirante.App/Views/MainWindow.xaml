<ui:FluentWindow x:Class="Mirante.App.Views.MainWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:tray="http://schemas.lepo.co/wpfui/2022/xaml/tray"
                 xmlns:views="clr-namespace:Mirante.App.Views"
                 xmlns:vm="clr-namespace:Mirante.App.ViewModels"
                 mc:Ignorable="d"
                 d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
                 Title="Mirante"
                 Icon="/Assets/mirante.ico"
                 Width="1280" Height="800" MinWidth="720" MinHeight="460"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ícone na área de notificação (só aparece com "Manter na bandeja ao fechar"). -->
        <tray:NotifyIcon x:Name="TrayIcon" Grid.Row="0" TooltipText="Mirante" Icon="/Assets/mirante-256.png"
                         FocusOnLeftClick="False" MenuOnRightClick="True">
            <tray:NotifyIcon.Menu>
                <ContextMenu>
                    <MenuItem Header="Abrir o Mirante" Icon="{ui:SymbolIcon Open24}" Click="OnTrayOpenClick" />
                    <Separator />
                    <MenuItem Header="Sair" Icon="{ui:SymbolIcon Dismiss24}" Click="OnTrayExitClick" />
                </ContextMenu>
            </tray:NotifyIcon.Menu>
        </tray:NotifyIcon>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="52">
            <ui:TitleBar.Header>
                <StackPanel Margin="16,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="20" Height="20" Source="/Assets/mirante-256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Mirante" />
                    <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Subtitle}" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.CenterContent>
                <Border x:Name="Toast" Padding="12,5" CornerRadius="14" Opacity="0" IsHitTestVisible="False"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Cursor="Hand" MouseLeftButtonUp="OnToastClick">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="15" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="ToastText" Margin="8,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock x:Name="ToastAction" Margin="10,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="Abrir pasta" />
                    </StackPanel>
                </Border>
            </ui:TitleBar.CenterContent>
            <ui:TitleBar.TrailingContent>
                <StackPanel Margin="0,0,8,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Aparece só quando uma versão nova já foi baixada; nada é instalado sem clique. -->
                    <ui:Button x:Name="UpdateButton" Style="{StaticResource TitleBarButton}" Appearance="Secondary"
                               Margin="0,0,8,0" Visibility="Collapsed" Icon="{ui:SymbolIcon ArrowDownload24}"
                               ToolTip="Reinicia o Mirante já na versão nova" Click="OnUpdateClick" />
                    <!-- Som: aparece enquanto alguma câmera estiver com o som ligado -->
                    <Border Margin="0,0,8,0" Padding="2,0,12,0" Height="32" CornerRadius="16" VerticalAlignment="Center"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Visibility="{Binding HasAudioTile, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource TitleBarButton}" Height="28" Padding="8,0" Margin="0"
                                       Icon="{ui:SymbolIcon Speaker224}" ToolTip="Desligar o som"
                                       Command="{Binding MuteAllCommand}" />
                            <TextBlock Margin="2,0,10,0" VerticalAlignment="Center" FontSize="12.5"
                                       Text="{Binding AudioTile.Name}" />
                            <Slider x:Name="VolumeSlider" Width="110" VerticalAlignment="Center" ToolTip="Volume"
                                    Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="10" IsMoveToPointEnabled="True"
                                    Value="{Binding Volume, Mode=TwoWay}" />
                            <TextBlock Width="26" Margin="6,0,0,0" VerticalAlignment="Center" TextAlignment="Right"
                                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="{Binding Volume}" />
                        </StackPanel>
                    </Border>
                    <!-- Câmeras abertas em janelas separadas: clique para trazer de volta -->
                    <ItemsControl ItemsSource="{Binding DetachedTiles}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CameraTileViewModel}">
                                <ui:Button Style="{StaticResource TitleBarButton}" Appearance="Secondary"
                                           Icon="{ui:SymbolIcon WindowArrowUp24}" Content="{Binding Name}"
                                           ToolTip="Trazer de volta ao mosaico"
                                           Command="{Binding DataContext.BringBackCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ui:Button Style="{StaticResource TitleBarButton}" Appearance="Primary" Margin="8,0,4,0"
                               Icon="{ui:SymbolIcon Add24}" Content="Adicionar câmera"
                               Command="{Binding AddCameraCommand}" ToolTip="Adicionar câmera (Ctrl+N)" />
                    <ui:Button Style="{StaticResource TitleBarButton}" Icon="{ui:SymbolIcon ImageMultiple24}"
                               ToolTip="Abrir pasta de fotos" Click="OnOpenSnapshotsClick" />
                    <ui:Button Style="{StaticResource TitleBarButton}" Icon="{ui:SymbolIcon FullScreenMaximize24}"
                               ToolTip="Tela cheia (F11)" Click="OnFullscreenClick" />
                    <ui:Button Style="{StaticResource TitleBarButton}" Icon="{ui:SymbolIcon Settings24}"
                               ToolTip="Configurações" Click="OnSettingsClick" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid x:Name="Stage" Grid.Row="1" Margin="10,2,10,10" SizeChanged="OnStageSizeChanged">
            <ItemsControl x:Name="TilesView" ItemsSource="{Binding Tiles}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Rows}" Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Visibility" Value="{Binding IsVisibleInGrid, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CameraTileViewModel}">
                        <views:CameraTile />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Estado vazio -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasCameras, Converter={StaticResource InverseBoolToVisibility}}">
                <Image Width="96" Height="96" Source="/Assets/mirante-256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Margin="0,24,0,8" HorizontalAlignment="Center" FontSize="24" FontWeight="SemiBold"
                           Text="Suas câmeras, num só lugar" />
                <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="14"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Adicione as câmeras da sua casa para vê-las ao vivo, lado a lado, sem depender da nuvem." />
                <ui:Button Margin="0,24,0,0" HorizontalAlignment="Center" Appearance="Primary" Padding="20,10"
                           Icon="{ui:SymbolIcon Add24}" Content="Adicionar a primeira câmera"
                           Command="{Binding AddCameraCommand}" />
                <StackPanel Margin="0,28,0,0" HorizontalAlignment="Center" Orientation="Horizontal" Opacity="0.75">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="Tudo fica no seu PC. Senhas guardadas pelo Windows." />
                </StackPanel>
            </StackPanel>

            <!-- Todas as câmeras estão em janelas separadas -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding AllDetached, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon HorizontalAlignment="Center" Symbol="WindowNew24" FontSize="40"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Margin="0,14,0,4" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           Text="Todas as câmeras estão em janelas separadas" />
                <TextBlock HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Use os botões no topo para trazê-las de volta." />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
