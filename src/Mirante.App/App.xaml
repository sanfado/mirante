<Application x:Class="Mirante.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:helpers="clr-namespace:Mirante.App.Helpers"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <helpers:ToneToBrushConverter x:Key="ToneToBrush" />

            <!-- Área de vídeo: sempre escura, nos dois temas. -->
            <SolidColorBrush x:Key="StageVideoBackground" Color="#FF0A0E15" />
            <SolidColorBrush x:Key="StageTileBorder" Color="#1FFFFFFF" />
            <LinearGradientBrush x:Key="OverlayBottomShade" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#B3000000" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="OverlayChrome" Color="#99101418" />

            <!-- Botão redondo usado sobre o vídeo. -->
            <Style x:Key="OverlayIconButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="CornerRadius" Value="17" />
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="16" />
            </Style>

            <!-- Botão da barra de título. -->
            <Style x:Key="TitleBarButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
