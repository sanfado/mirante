<ui:FluentWindow x:Class="Mirante.App.Views.SettingsWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Configurações"
                 Width="560" SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,20,0,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,0,28,24">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Configurações" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Aparência" />
            <ui:CardControl Icon="{ui:SymbolIcon PaintBrush24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="13.5" Text="Tema" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="O vídeo fica sempre sobre fundo escuro." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="ThemeBox" MinWidth="170" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="Escuro" Tag="Dark" />
                    <ComboBoxItem Content="Claro" Tag="Light" />
                    <ComboBoxItem Content="Igual ao Windows" Tag="System" />
                </ComboBox>
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Fotos" />
            <ui:CardControl Icon="{ui:SymbolIcon ImageMultiple24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="13.5" Text="Pasta das fotos" />
                        <TextBlock x:Name="FolderText" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Appearance="Secondary" Content="Abrir" Click="OnOpenFolderClick" />
                    <ui:Button Margin="8,0,0,0" Appearance="Secondary" Content="Alterar…" Click="OnChangeFolderClick" />
                </StackPanel>
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Gravações" />
            <TextBlock Margin="2,-2,0,8" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Locais onde as gravações ficam, por exemplo um HD para cada. As câmeras em “Automático” gravam no primeiro local com espaço, nesta ordem; ao atingir o limite, passam para o próximo, e com todos cheios as contínuas mais antigas dão lugar às novas. No menu de cada câmera dá para fixá-la num local." />
            <StackPanel x:Name="LocationList" />
            <ui:Button x:Name="AddLocationButton" Margin="0,6,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon Add24}"
                       Content="Adicionar local…" Click="OnAddLocationClick" />
            <ui:CardControl Margin="0,10,0,0" Icon="{ui:SymbolIcon CalendarClock24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="13.5" Text="Apagar gravações contínuas depois de" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Uma câmera 2K gravando sem parar usa cerca de 13 GB por dia. As gravações manuais (“Gravar agora”) nunca são apagadas automaticamente." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="RetentionBox" MinWidth="130" SelectionChanged="OnRetentionChanged" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Inicialização" />
            <ui:CardControl Icon="{ui:SymbolIcon Power24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="13.5" Text="Iniciar com o Windows" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Abre o Mirante quando você entra no Windows." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupToggle" Click="OnStartupToggled" />
            </ui:CardControl>
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon ArrowMinimize24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="13.5" Text="Manter na bandeja ao fechar" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Fechar a janela deixa o Mirante perto do relógio, sem gastar processamento com vídeo. Junto com a opção acima, ele já abre na bandeja." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="TrayToggle" Click="OnTrayToggled" />
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Atualizações" />
            <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="13.5" Text="Procurar atualizações automaticamente" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Consulta as versões publicadas do Mirante no GitHub a cada poucas horas e baixa em segundo plano. Nada é instalado sem você clicar." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="UpdatesToggle" Click="OnUpdatesToggled" />
            </ui:CardControl>
            <ui:CardControl Margin="0,4,0,0" Icon="{ui:SymbolIcon ArrowDownload24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock x:Name="UpdateTitle" FontSize="13.5" />
                        <TextBlock x:Name="UpdateDetail" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:ProgressRing x:Name="UpdateBusy" Width="18" Height="18" Margin="0,0,10,0"
                                     IsIndeterminate="True" Visibility="Collapsed" />
                    <ui:Button x:Name="CheckUpdatesButton" Appearance="Secondary" Content="Procurar agora"
                               Click="OnCheckUpdatesClick" />
                    <ui:Button x:Name="ApplyUpdateButton" Margin="8,0,0,0" Appearance="Primary"
                               Content="Reiniciar e atualizar" Visibility="Collapsed" Click="OnApplyUpdateClick" />
                </StackPanel>
            </ui:CardControl>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Privacidade e segurança" />
            <ui:CardControl Icon="{ui:SymbolIcon ShieldCheckmark24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontSize="13.5" TextWrapping="Wrap" Text="Tudo fica no seu PC" />
                        <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="O Mirante conversa com as câmeras da sua rede e, se você deixar, com o GitHub para procurar atualizações. Sem nuvem, sem contas, sem telemetria. As senhas ficam no Gerenciador de Credenciais do Windows. Fotos e gravações ficam só neste PC, sem criptografia própria: para protegê-las, use o BitLocker do Windows." />
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>

            <StackPanel Margin="2,24,0,0" Orientation="Horizontal">
                <Image Width="20" Height="20" Source="/Assets/mirante-256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="VersionText" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="28,16" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <ui:Button HorizontalAlignment="Right" Appearance="Primary" Content="Fechar" MinWidth="96"
                       IsDefault="True" IsCancel="True" Click="OnCloseClick" />
        </Border>
    </Grid>
</ui:FluentWindow>
