<UserControl x:Class="Mirante.App.Views.CameraTile"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             xmlns:vm="clr-namespace:Mirante.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CameraTileViewModel}"
             d:DesignWidth="640" d:DesignHeight="360">
    <UserControl.Resources>
        <SolidColorBrush x:Key="PtzArrowPressed" Color="#CC3B6FD9" />
        <!-- Setas de mover a câmera: segurar move, soltar para -->
        <Style x:Key="PtzArrow" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Background" Value="#80101418" />
            <Setter Property="BorderBrush" Value="#40FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#B3101418" />
                    <Setter Property="BorderBrush" Value="#80FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PtzGlyph" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource StageVideoBackground}"
            BorderBrush="{StaticResource StageTileBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="1">
        <!--
            O vídeo é uma janela nativa (HWND) e fica por cima de qualquer conteúdo WPF.
            Por isso tudo que aparece sobre o vídeo vai DENTRO do VideoView: o LibVLCSharp
            desenha esse conteúdo numa janela transparente sobreposta.
        -->
        <vlc:VideoView x:Name="Video">
            <Grid x:Name="Overlay"
                  Background="#01000000"
                  MouseEnter="OnOverlayMouseEnter"
                  MouseLeave="OnOverlayMouseLeave"
                  MouseLeftButtonDown="OnOverlayMouseDown">

                <!-- Sem imagem: fundo escuro e fixo (o espaço nativo do vídeo deixa o Mica aparecer) -->
                <Border Background="{StaticResource StageVideoBackground}"
                        Visibility="{Binding HasNoPicture, Converter={StaticResource BoolToVisibility}}" />

                <!-- Faixas em volta da imagem (letterbox), desenhadas aqui: as do próprio VLC saem
                     pretas e o Windows as torna transparentes sobre o efeito Mica. -->
                <Path x:Name="Bars" Fill="{StaticResource StageVideoBackground}" IsHitTestVisible="False" />

                <!-- Conectando / reconectando -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowSpinner, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" Width="36" Height="36" Foreground="#FFB4C6FF" />
                    <TextBlock Margin="0,14,0,0" HorizontalAlignment="Center" Foreground="#CCFFFFFF"
                               FontSize="13" Text="{Binding BusyText}" />
                </StackPanel>

                <!-- Problema: sem conexão, senha recusada, sem senha -->
                <StackPanel MaxWidth="360" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowProblem, Converter={StaticResource BoolToVisibility}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="#1AFFFFFF" HorizontalAlignment="Center">
                        <TextBlock x:Name="ProblemGlyph" FontFamily="{StaticResource FluentSystemIcons}" FontSize="26"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFCA5A5" />
                    </Border>
                    <TextBlock Margin="0,14,0,4" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="White" FontSize="15" FontWeight="SemiBold" Text="{Binding ProblemTitle}" />
                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#B3FFFFFF" FontSize="12.5" Text="{Binding ProblemMessage}" />
                    <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Content="Editar câmera" Command="{Binding EditCommand}"
                                   Icon="{ui:SymbolIcon Edit24}"
                                   Visibility="{Binding ShowEditAction, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Secondary" Content="Tentar agora" Command="{Binding RetryCommand}"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    </StackPanel>
                </StackPanel>

                <!-- Rodapé: nome + status -->
                <Border VerticalAlignment="Bottom" Height="64" Background="{StaticResource OverlayBottomShade}"
                        IsHitTestVisible="False" />
                <DockPanel Margin="14,0,14,12" VerticalAlignment="Bottom" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="White" FontSize="14"
                               FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <Border DockPanel.Dock="Left" Margin="10,0,0,0" Padding="8,3" CornerRadius="10"
                            Background="{StaticResource OverlayChrome}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding Tone, Converter={StaticResource ToneToBrush}}" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="#E6FFFFFF"
                                       FontSize="10.5" FontWeight="SemiBold" Text="{Binding StatusLabel}" />
                            <!-- Som ligado nesta câmera -->
                            <TextBlock x:Name="AudioGlyph" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{StaticResource FluentSystemIcons}" FontSize="13" Foreground="#FFB4C6FF"
                                       ToolTip="Som ligado"
                                       Visibility="{Binding IsAudioOn, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Mover a câmera (PTZ): setas nas bordas, aparecem com o botão "Mover câmera" -->
                <Grid x:Name="PtzPad" Margin="14,14,14,50"
                      Visibility="{Binding ShowPtzPad, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource PtzArrow}" Tag="0,1,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                            ToolTip="Para cima (↑)" MouseLeftButtonDown="OnPtzArrowDown" MouseLeftButtonUp="OnPtzArrowUp" LostMouseCapture="OnPtzArrowLost">
                        <ui:SymbolIcon Symbol="ChevronUp24" Style="{StaticResource PtzGlyph}" />
                    </Border>
                    <Border Style="{StaticResource PtzArrow}" Tag="0,-1,0" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            ToolTip="Para baixo (↓)" MouseLeftButtonDown="OnPtzArrowDown" MouseLeftButtonUp="OnPtzArrowUp" LostMouseCapture="OnPtzArrowLost">
                        <ui:SymbolIcon Symbol="ChevronDown24" Style="{StaticResource PtzGlyph}" />
                    </Border>
                    <Border Style="{StaticResource PtzArrow}" Tag="-1,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                            ToolTip="Para a esquerda (←)" MouseLeftButtonDown="OnPtzArrowDown" MouseLeftButtonUp="OnPtzArrowUp" LostMouseCapture="OnPtzArrowLost">
                        <ui:SymbolIcon Symbol="ChevronLeft24" Style="{StaticResource PtzGlyph}" />
                    </Border>
                    <Border Style="{StaticResource PtzArrow}" Tag="1,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="Para a direita (→)" MouseLeftButtonDown="OnPtzArrowDown" MouseLeftButtonUp="OnPtzArrowUp" LostMouseCapture="OnPtzArrowLost">
                        <ui:SymbolIcon Symbol="ChevronRight24" Style="{StaticResource PtzGlyph}" />
                    </Border>
                    <!-- Zoom (só em câmeras que informam zoom óptico via ONVIF) -->
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal"
                                Visibility="{Binding Ptz.SupportsZoom, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource PtzArrow}" Tag="0,0,-1" Width="40" Height="40" CornerRadius="20"
                                ToolTip="Afastar (−)" MouseLeftButtonDown="OnPtzArrowDown" MouseLeftButtonUp="OnPtzArrowUp" LostMouseCapture="OnPtzArrowLost">
                            <ui:SymbolIcon Symbol="ZoomOut24" Style="{StaticResource PtzGlyph}" FontSize="19" />
                        </Border>
                        <Border Style="{StaticResource PtzArrow}" Tag="0,0,1" Width="40" Height="40" CornerRadius="20" Margin="8,0,0,0"
                                ToolTip="Aproximar (+)" MouseLeftButtonDown="OnPtzArrowDown" MouseLeftButtonUp="OnPtzArrowUp" LostMouseCapture="OnPtzArrowLost">
                            <ui:SymbolIcon Symbol="ZoomIn24" Style="{StaticResource PtzGlyph}" FontSize="19" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Ações (aparecem ao passar o mouse) -->
                <Border x:Name="Actions" Margin="10" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                        CornerRadius="21" Background="{StaticResource OverlayChrome}" Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="AudioButton" Style="{StaticResource OverlayIconButton}"
                                   Icon="{ui:SymbolIcon SpeakerMute24}" ToolTip="Ligar o som (M)"
                                   Command="{Binding ToggleAudioCommand}" />
                        <ui:Button x:Name="PtzButton" Style="{StaticResource OverlayIconButton}"
                                   Icon="{ui:SymbolIcon ArrowMove24}" ToolTip="Mover a câmera"
                                   Command="{Binding TogglePtzModeCommand}"
                                   Visibility="{Binding Ptz.IsAvailable, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Style="{StaticResource OverlayIconButton}" Icon="{ui:SymbolIcon Camera24}"
                                   ToolTip="Tirar foto (F)" Command="{Binding SnapshotCommand}" />
                        <ui:Button x:Name="DetachButton" Style="{StaticResource OverlayIconButton}"
                                   Icon="{ui:SymbolIcon WindowNew24}" ToolTip="Abrir em janela separada"
                                   Command="{Binding ToggleDetachCommand}" />
                        <ui:Button x:Name="FocusButton" Style="{StaticResource OverlayIconButton}"
                                   Icon="{ui:SymbolIcon FullScreenMaximize24}" ToolTip="Tela cheia (F11)"
                                   Command="{Binding FullscreenCommand}" />
                        <ui:Button x:Name="MoreButton" Style="{StaticResource OverlayIconButton}"
                                   Icon="{ui:SymbolIcon MoreHorizontal24}" ToolTip="Mais opções"
                                   Click="OnMoreClick">
                            <ui:Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Editar câmera" Command="{Binding EditCommand}"
                                              Icon="{ui:SymbolIcon Edit24}" />
                                    <MenuItem Header="Reconectar" Command="{Binding RetryCommand}"
                                              Icon="{ui:SymbolIcon ArrowClockwise24}" />
                                    <MenuItem Header="Organizar câmeras…" Command="{Binding OrganizeCommand}"
                                              Icon="{ui:SymbolIcon ArrowSort24}" />
                                    <Separator />
                                    <MenuItem Header="Remover câmera" Command="{Binding RemoveCommand}"
                                              Icon="{ui:SymbolIcon Delete24}" />
                                </ContextMenu>
                            </ui:Button.ContextMenu>
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>
        </vlc:VideoView>
    </Border>
</UserControl>
