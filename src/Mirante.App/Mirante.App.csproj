<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Mirante</AssemblyName>
    <RootNamespace>Mirante.App</RootNamespace>
    <ApplicationIcon>Assets\mirante.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main (Velopack precisa rodar antes do WPF). -->
    <StartupObject>Mirante.App.Program</StartupObject>
    <!-- Só 64 bits: o pacote do LibVLC traz x86 e x64; não distribuímos o x86. -->
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!--
    Só os plugins do VLC que o Mirante usa (lista de permitidos, ~330 → ~60):
    RTSP + decodificação H.264/H.265/MJPEG na GPU + áudio da câmera + saída de vídeo + foto.
    Fica de fora: codificadores (ex.: x264, GPL), DVD/Blu-ray, legendas, efeitos de áudio,
    streaming de saída, cofre de senhas em arquivo, Lua etc. Menos superfície de ataque, menor
    instalador e nenhum componente GPL desnecessário. Ao ligar um recurso novo, acrescente aqui.
  -->
  <!-- Diagnóstico: dotnet build -p:MiranteFullVlc=true inclui todos os plugins, para comparar. -->
  <ItemGroup Condition="'$(MiranteFullVlc)' == 'true'">
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll;plugins\%2A%2A" />
  </ItemGroup>
  <ItemGroup Condition="'$(MiranteFullVlc)' != 'true'">
    <VlcWindowsX64IncludeFiles Include="libvlc.dll;libvlccore.dll" />
    <!-- Entrada: RTSP (live555) e arquivos locais (modo demonstração) -->
    <VlcWindowsX64IncludeFiles Include="plugins\access\liblive555_plugin.dll;plugins\access\libfilesystem_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\demux\libmp4_plugin.dll;plugins\demux\libes_plugin.dll;plugins\demux\libh26x_plugin.dll;plugins\demux\libts_plugin.dll;plugins\demux\libmjpeg_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\libpacketizer_h264_plugin.dll;plugins\packetizer\libpacketizer_hevc_plugin.dll;plugins\packetizer\libpacketizer_copy_plugin.dll;plugins\packetizer\libpacketizer_mpeg4video_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\stream_filter\libcache_read_plugin.dll;plugins\stream_filter\libcache_block_plugin.dll;plugins\stream_filter\libprefetch_plugin.dll" />
    <!-- Decodificação (FFmpeg + aceleração D3D11/DXVA2) e imagens (foto em PNG) -->
    <VlcWindowsX64IncludeFiles Include="plugins\codec\libavcodec_plugin.dll;plugins\codec\libd3d11va_plugin.dll;plugins\codec\libdxva2_plugin.dll;plugins\codec\libpng_plugin.dll;plugins\codec\libjpeg_plugin.dll;plugins\codec\librawvideo_plugin.dll" />
    <!-- Saída de vídeo dentro da janela do app -->
    <VlcWindowsX64IncludeFiles Include="plugins\video_output\libdirect3d11_plugin.dll;plugins\video_output\libdirect3d9_plugin.dll;plugins\video_output\libdrawable_plugin.dll;plugins\video_output\libwingdi_plugin.dll;plugins\video_output\libvdummy_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\video_chroma\%2A;plugins\d3d11\%2A;plugins\d3d9\%2A" />
    <VlcWindowsX64IncludeFiles Include="plugins\video_filter\libdeinterlace_plugin.dll;plugins\video_filter\libscale_plugin.dll;plugins\video_filter\libtransform_plugin.dll" />
    <!-- Áudio da câmera (G.711/AAC/PCM), mixagem, conversão e saída pelo Windows -->
    <VlcWindowsX64IncludeFiles Include="plugins\audio_output\libmmdevice_plugin.dll;plugins\audio_output\libwasapi_plugin.dll;plugins\audio_output\libdirectsound_plugin.dll;plugins\audio_output\libwaveout_plugin.dll;plugins\audio_output\libadummy_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_mixer\%2A" />
    <VlcWindowsX64IncludeFiles Include="plugins\audio_filter\libaudio_format_plugin.dll;plugins\audio_filter\libspeex_resampler_plugin.dll;plugins\audio_filter\libugly_resampler_plugin.dll;plugins\audio_filter\libtrivial_channel_mixer_plugin.dll;plugins\audio_filter\libsimple_channel_mixer_plugin.dll;plugins\audio_filter\libremap_plugin.dll;plugins\audio_filter\libscaletempo_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\codec\libg711_plugin.dll;plugins\codec\libaraw_plugin.dll;plugins\codec\liblpcm_plugin.dll;plugins\codec\libadpcm_plugin.dll" />
    <VlcWindowsX64IncludeFiles Include="plugins\packetizer\libpacketizer_mpeg4audio_plugin.dll;plugins\packetizer\libpacketizer_mpegaudio_plugin.dll" />
    <!-- Cofre de senhas só em memória (opção keystore=memory) -->
    <VlcWindowsX64IncludeFiles Include="plugins\keystore\libmemory_keystore_plugin.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" />
    <PackageReference Include="WPF-UI.Tray" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="LibVLCSharp.WPF" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mirante.Core\Mirante.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Projetos WPF não importam System.IO por padrão. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Licença e avisos de terceiros vão junto com o app instalado. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\mirante.ico" />
    <Resource Include="Assets\mirante-256.png" />
  </ItemGroup>

</Project>
