<ui:FluentWindow x:Class="Mirante.App.Views.DetachedCameraWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:Mirante.App.Views"
                 Icon="/Assets/mirante.ico"
                 Width="960" Height="590" MinWidth="400" MinHeight="260"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Height="40">
            <ui:TitleBar.Header>
                <StackPanel Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="16" Height="16" Source="/Assets/mirante-256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="· Mirante" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        <views:CameraTile x:Name="Tile" Grid.Row="1" Margin="6,0,6,6" IsInDetachedWindow="True" />
    </Grid>
</ui:FluentWindow>
