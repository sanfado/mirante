<ui:FluentWindow x:Class="Mirante.App.Views.OrganizeCamerasWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Organizar câmeras"
                 Width="460" SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,0,28,20">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Organizar câmeras" />
            <TextBlock Margin="0,4,0,16" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Arraste ou use as setas. A ordem vale para o mosaico e para as teclas 1 a 9." />

            <Border Padding="4" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListBox x:Name="List" MaxHeight="380" AllowDrop="True" Background="Transparent" BorderThickness="0"
                         PreviewMouseLeftButtonDown="OnListMouseDown" PreviewMouseMove="OnListMouseMove"
                         DragOver="OnListDragOver" Drop="OnListDrop" SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Cursor="SizeAll"
                                           FontFamily="{StaticResource FluentSystemIcons}" FontSize="16"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding Glyph}" ToolTip="Arraste para mudar a ordem" />
                                <Border Grid.Column="1" Width="26" Height="22" CornerRadius="6" HorizontalAlignment="Left"
                                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                               FontWeight="SemiBold" Text="{Binding Position}" />
                                </Border>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="14"
                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="UpButton" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowUp24}" Content="Subir"
                           Click="OnUpClick" />
                <ui:Button x:Name="DownButton" Margin="8,0,0,0" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowDown24}"
                           Content="Descer" Click="OnDownClick" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Padding="28,16" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Content="Cancelar" MinWidth="96" IsCancel="True" />
                <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Salvar ordem" MinWidth="110"
                           IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
