<ui:FluentWindow x:Class="Mirante.App.Views.NameWindow"
                 x:ClassModifier="internal"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Nome"
                 Width="400" SizeToContent="Height"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Height="36" ShowMaximize="False" ShowMinimize="False" />

        <StackPanel Grid.Row="1" Margin="28,0,28,24">
            <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" />
            <TextBlock x:Name="Hint" Margin="0,4,0,16" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:TextBox x:Name="NameBox" MaxLength="40"
                        TextChanged="OnNameChanged" />
        </StackPanel>

        <Border Grid.Row="2" Padding="28,16" Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button Appearance="Secondary" Content="Cancelar" MinWidth="96" IsCancel="True" />
                <ui:Button x:Name="SaveButton" Margin="8,0,0,0" Appearance="Primary" Content="Salvar" MinWidth="96"
                           IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
